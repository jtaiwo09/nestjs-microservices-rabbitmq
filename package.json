{
  "name": "nest-microservices-course",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "graphify:setup": "graphify install",
    "graphify:build": "graphify . --update"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "packages/*"
  ],
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
